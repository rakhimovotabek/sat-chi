{
  "name": "satchi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --expose-gc --import ./scripts/testing/release-memory.js --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "import:inspect": "node scripts/imports/local-books.js",
    "import:apply": "node scripts/imports/apply-local-imports.js",
    "import:check": "node scripts/imports/sample-check.js",
    "format": "prettier --write src scripts tests docs README.md package.json",
    "format:check": "prettier --check src/features/learning/Vocabulary*.jsx src/features/learning/vocabulary-*.js",
    "import:report": "node scripts/imports/report.js",
    "import:check-vocabulary": "node scripts/imports/check-vocabulary.js",
    "lint": "eslint src scripts tests",
    "import:covers": "node scripts/imports/backfill-covers.js",
    "import:vocabook": "node scripts/imports/vocabook-package.js",
    "test:reliability": "node scripts/testing/reliability.js",
    "dev:isolated": "node scripts/testing/manual-development.js",
    "test:platform": "node scripts/testing/platform.js",
    "dev:platform": "node scripts/testing/platform-development.js",
    "prepare:platform-previews": "node scripts/books/prepare-platform-previews.js",
    "test:sprint": "node --expose-gc --import ./scripts/testing/release-memory.js --test --test-concurrency=1 tests/universal-book.test.js tests/battles.test.js tests/sat-numeric-response.test.js tests/math-typesetting.test.js tests/embedded-answer-choices.test.js tests/first-attempt-statistics.test.js tests/shared-question-history.test.js tests/book-package.test.js",
    "test:sprint:ui": "playwright test tests/browser/universal-book-preview.spec.js --workers=1",
    "book:validate": "node scripts/imports/validate-universal.js",
    "test:sprint:native": "node scripts/testing/sprint-native.js",
    "test:sprint:services": "node scripts/testing/sprint-native.js --services",
    "test:realtime": "node scripts/testing/sprint-native.js --services --realtime",
    "test:battles:browser": "node scripts/testing/sprint-native.js --services --battle-browser",
    "test:battles:network": "node scripts/testing/sprint-native.js --services --battle-network",
    "test:battles:timer": "node scripts/testing/sprint-native.js --services --battle-timer",
    "test:battles:matching": "node scripts/testing/sprint-native.js --services --battle-matching",
    "test:battles:quick": "node scripts/testing/sprint-native.js --services --quick-match",
    "test:analytics:native": "node scripts/testing/sprint-native.js --services --analytics",
    "test:battles:reading": "node scripts/testing/sprint-native.js --services --reading",
    "setup:test-services": "python3 scripts/testing/setup-supabase-services.py",
    "setup:test-tools": "python3 scripts/testing/setup-native-tools.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "katex": "0.19.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "vite": "^8.3.2"
  }
}
